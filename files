// app/globals.css
@layer utilities {
  .image-grade {
    filter: saturate(0.9) contrast(1.05) hue-rotate(178deg);
  }

  .photo-grade {
    background:
      linear-gradient(to bottom, rgba(2, 164, 185, 0.10), rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.35));
  }

  .glass-hover {
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }
  .glass-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(1, 249, 198, 0.12), 0 6px 20px rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .btn-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .btn-hover:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(1, 249, 198, 0.25), 0 6px 16px rgba(0, 0, 0, 0.3);
  }

  .section-spacing {
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .section-spacing {
      margin-bottom: 6rem;
    }
  }
  @media (min-width: 1024px) {
    .section-spacing {
      margin-bottom: 7.5rem;
    }
  }

  .icon-6 {
    width: 1.5rem;
    height: 1.5rem;
  }
}

